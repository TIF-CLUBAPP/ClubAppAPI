429|     // Ej: "Julio 2026"
430|     private static string FormatPeriodo(string period, DateTime? fallbackDate = null)
431|     {
432|         // period = "yyyy-MM" (formato estándar ISO) o "MM/yyyy" (legacy) o "Mes Año" (legacy)
433|         bool hasValidPeriod = !string.IsNullOrWhiteSpace(period) && period.Length >= 7;
434| 
435|         if (hasValidPeriod)
436|         {
437|             int month = 0, year = 0;
438|             
439|             // Intentar parsear como "yyyy-MM" (nuevo formato estándar)
440|             if (period.Contains("-") && int.TryParse(period.AsSpan(0, 4), out year) && int.TryParse(period.AsSpan(5, 2), out month))
441|             {
442|                 var culture = CultureInfo.GetCultureInfo("es-AR");
443|                 var monthName = culture.DateTimeFormat.GetMonthName(month);
444|                 var capitalized = char.ToUpperInvariant(monthName[0]) + monthName.Substring(1);
445|                 return $"{capitalized} {year}";
446|             }
447|             
448|             // Intentar parsear como "MM/yyyy" (legacy)
449|             if (period.Contains("/") && int.TryParse(period.AsSpan(0, 2), out month) && int.TryParse(period.AsSpan(3, 4), out year))
450|             {
451|                 var culture = CultureInfo.GetCultureInfo("es-AR");
452|                 var monthName = culture.DateTimeFormat.GetMonthName(month);
453|                 var capitalized = char.ToUpperInvariant(monthName[0]) + monthName.Substring(1);
454|                 return $"{capitalized} {year}";
455|             }
456|             
457|             // Si ya está en formato "Mes Año" (longitud > 7), devolver tal cual
458|             if (period.Length > 7)
459|             {
460|                 return period;
461|             }
462|         }
463| 
464|         // Si no hay período válido, generar desde fallbackDate (CreatedAt o DueDate)
465|         if (fallbackDate.HasValue)
466|         {
467|             var culture = CultureInfo.GetCultureInfo("es-AR");
468|             var monthName = culture.DateTimeFormat.GetMonthName(fallbackDate.Value.Month);
469|             var capitalized = char.ToUpperInvariant(monthName[0]) + monthName.Substring(1);
470|             return $"{capitalized} {fallbackDate.Value.Year}";
471|         }
