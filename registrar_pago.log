398|     public async Task<string> RegistrarPagoAsync(int cuotaId)
399|     {
400|         var payment = await _context.Payments
401|             .Include(p => p.User)
402|             .FirstOrDefaultAsync(p => p.Id == cuotaId);
403| 
404|         if (payment == null) return "NOT_FOUND";
405|         if (payment.Status == PaymentStatus.Paid) return "ALREADY_PAID";
406| 
407|         var now = DateTime.UtcNow;
408| 
409|         payment.Status = PaymentStatus.Paid;
410|         payment.PaymentDate = now;
411| 
412|         var membership = await _context.Memberships
413|             .FirstOrDefaultAsync(m => m.UserId == payment.UserId);
414|         if (membership != null)
415|         {
416|             membership.Status = MembershipStatus.ACTIVE;
417|         }
418| 
419|         var user = await _context.Users.FirstOrDefaultAsync(u => u.Id == payment.UserId);
420|         if (user != null)
421|         {
422|             user.LastPaymentDate = now;
423|         }
424| 
425|         await _context.SaveChangesAsync();
426|         return "OK";
427|     }
