# Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Mercado Pago - Clave pública (SOLO necesaria si se integra el SDK/Checkout en el navegador).
# El flujo actual de pago (redirección a init_point desde el backend) NO la requiere.
VITE_MERCADOPAGO_PUBLIC_KEY=
