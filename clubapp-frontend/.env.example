# Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Mercado Pago - Clave pública. Requerida para tokenizar tarjetas en el navegador
# (pago con "Tarjeta" vía SDK v2 / createCardToken). El flujo "Mercado Pago"
# (Checkout Pro) sigue sin requerirla.
VITE_MERCADOPAGO_PUBLIC_KEY=

# Mapbox Geocoding - Token público (pk.*) para autocompletado de direcciones.
# Se obtiene en https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=
